# MCP Framework - Environment Variables Template
# This file contains all required environment variables for Azure deployment
# Copy this file to .env and fill in the values

# ============================================================================
# AZURE RESOURCE CONFIGURATION
# ============================================================================

# Resource Group
AZURE_RESOURCE_GROUP=your-resource-group-name

# Location (Azure Region)
AZURE_LOCATION=eastus

# Function App Configuration
AZURE_FUNCTION_APP_NAME=your-function-app-name
AZURE_FUNCTION_APP_SKU=Y1  # Consumption Plan
AZURE_FUNCTION_APP_RUNTIME=python
AZURE_FUNCTION_APP_RUNTIME_VERSION=3.11

# Storage Account Configuration
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccountname
AZURE_STORAGE_ACCOUNT_SKU=Standard_LRS
AZURE_STORAGE_ACCOUNT_KIND=StorageV2
AZURE_STORAGE_ACCESS_TIER=Hot

# Application Insights Configuration
AZURE_APP_INSIGHTS_NAME=your-app-insights-name
AZURE_APP_INSIGHTS_RETENTION_DAYS=90

# ============================================================================
# REQUIRED AZURE RESOURCE TAGS
# These tags are REQUIRED for all Azure resources
# ============================================================================

# Application Name (Required)
APPLICATION_NAME=MCPFramework

# Business Owner (Required - email address)
BUSINESS_OWNER=business-owner@example.com

# Cost Centre (Required - cost center code)
COST_CENTRE=CC001

# Environment (Required - Deployment environment)
ENVIRONMENT=Development

# Project (Required - Project name)
PROJECT=MCPPlatform

# Technical Owner (Required - email address)
TECHNICAL_OWNER=tech-owner@example.com

# ============================================================================
# MCP FRAMEWORK CONFIGURATION
# ============================================================================

# MCP Server Configuration
MCP_SERVER_NAME=MCP Framework Server
MCP_SERVER_VERSION=1.0.0
MCP_PROTOCOL_VERSION=2024-11-05
MCP_ENVIRONMENT=Development
MCP_DOMAIN=YourDomain

# MCP Framework Settings
MCP_ENABLE_TELEMETRY=true
MCP_ENABLE_AUDIT=true
MCP_ENABLE_AUTH=false
MCP_ENABLE_AUTHORIZATION=false
MCP_ENABLE_CLASSIFICATION=false

# ============================================================================
# AZURE FUNCTIONS CONFIGURATION
# ============================================================================

# Function App Settings
FUNCTIONS_WORKER_RUNTIME=python
FUNCTIONS_EXTENSION_VERSION=~4
WEBSITE_RUN_FROM_PACKAGE=1
ENABLE_ORYX_BUILD=true
SCM_DO_BUILD_DURING_DEPLOYMENT=true

# Python Configuration
PYTHON_VERSION=3.11

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# AzureWebJobsStorage - Will be set automatically during deployment
# AZUREWEBJOBSSTORAGE=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================

# Azure AD Configuration (Optional)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ============================================================================
# FABRIC CONFIGURATION
# ============================================================================

# Microsoft Fabric Configuration (Optional)
FABRIC_TENANT_ID=your-fabric-tenant-id
FABRIC_WORKSPACE_ID=your-workspace-id

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Deployment Method (remote or local)
DEPLOYMENT_METHOD=remote

# ============================================================================
# COPILOT INTEGRATION (Optional)
# ============================================================================

# Copilot Studio Configuration
COPILOT_STUDIO_ENDPOINT=https://your-function-app.azurewebsites.net
COPILOT_STUDIO_API_KEY=your-api-key

# ============================================================================
# NOTES
# ============================================================================

# 1. All variables with prefix "AZURE_" are used for Azure resource creation
# 2. All variables with prefix "MCP_" are used for MCP Framework configuration
# 3. All variables listed under "REQUIRED AZURE RESOURCE TAGS" must be set
# 4. Copy this file to .env and fill in the values before deployment
# 5. Never commit .env file to version control (it's in .gitignore)
# 6. For production, use Azure Key Vault or Function App settings for secrets

# ============================================================================
# EXAMPLE VALUES FOR DEVELOPMENT
# ============================================================================

# Development example:
# AZURE_RESOURCE_GROUP=mcp-dev-rg
# AZURE_LOCATION=eastus
# AZURE_FUNCTION_APP_NAME=mcp-dev-func
# AZURE_STORAGE_ACCOUNT_NAME=mcpdevstorage
# AZURE_APP_INSIGHTS_NAME=mcp-dev-appinsights
# APPLICATION_NAME=MCPFramework
# BUSINESS_OWNER=dev-team@example.com
# COST_CENTRE=DEV001
# ENVIRONMENT=Development
# PROJECT=MCPPlatform
# TECHNICAL_OWNER=dev-lead@example.com
